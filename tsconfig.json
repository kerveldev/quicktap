{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "vite/client",
      "node"
    ],
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "resources/js/**/*.ts",
    "resources/js/**/*.vue",
    "tests/Frontend/**/*.ts",
    "vite.config.ts",
    "playwright.config.ts"
  ]
}
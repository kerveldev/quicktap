{
  "name": "quicktap",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "assets": "node scripts/sync-assets.mjs",
    "format": "prettier --write resources/js resources/css tests/Frontend tests/Browser scripts vite.config.ts playwright.config.ts",
    "format:check": "prettier --check resources/js resources/css tests/Frontend tests/Browser scripts vite.config.ts playwright.config.ts"
  },
  "dependencies": {
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "laravel-vite-plugin": "^2.0.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.1"
  }
}
